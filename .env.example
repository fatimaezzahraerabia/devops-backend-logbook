# 🚀 Variables d'Environnement (Exemple & Modèle)
# Copier ce fichier sous .env pour un environnement de développement local:
# cp .env.example .env

# App Configuration
PROJECT_NAME="Task Manager API"
ENVIRONMENT="development"
LOG_LEVEL="INFO"
DEBUG=True

# Security & Secrets (NE JAMAIS COMMITTER LE FICHIER .env AVEC LES VRAIES CLEFS)
SECRET_KEY="change_me_super_secret_jwt_key_development_only"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (PostgreSQL / Neon DB)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_dev_password"
POSTGRES_DB="task_manager_db"
DATABASE_URL="postgresql+asyncpg://postgres:postgres_dev_password@localhost:5432/task_manager_db"

# Redis & ARQ Worker Configuration
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379/0"

# Decap CMS OAuth Proxy Configuration (Optionnel pour l'édition Web)
OAUTH_PROXY_URL="https://gatekeeper-oauth.koyeb.app"
