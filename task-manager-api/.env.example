PROJECT_NAME="Task Manager API"
ENVIRONMENT="development"
LOG_LEVEL="INFO"
DEBUG=True

SECRET_KEY="dev_super_secret_jwt_key_must_be_changed_in_prod"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

POSTGRES_SERVER="db"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_dev_password"
POSTGRES_DB="task_db"
DATABASE_URL="postgresql+asyncpg://postgres:postgres_dev_password@db:5432/task_db"

REDIS_HOST="redis"
REDIS_PORT=6379
REDIS_URL="redis://redis:6379/0"
